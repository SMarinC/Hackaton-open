# Node >=22.13. Copy to .env locally; never commit credentials.
PORT=8787
PANELA_DB_PATH=data/private/panela.sqlite
# Fixture only; video dwell never confirms stock.
PANELA_INVENTORY_FIXTURE=unknown

# No external sends by default. Every send also checks the allowlists below.
PANELA_LIVE_SEND=false
# With live send on, dispatch newly queued messages automatically. Failed or
# uncertain messages are never retried automatically; use "Reintentar envío".
PANELA_AUTO_SEND=false
# Bot token (xoxb-) with chat:write; invite the bot to the channel. Use the channel ID.
SLACK_BOT_TOKEN=
PANELA_SLACK_CHANNEL=
PANELA_ALLOWED_SLACK_CHANNELS=
# onboarding@resend.dev can only send to the Resend account owner's address.
# Verify your own domain in Resend to reach any other recipient.
RESEND_API_KEY=
PANELA_EMAIL_FROM=
# External recipient for supplier queries (ask_eta).
PANELA_EMAIL_TO=
# Internal recipient for case status reports (they include operator notes).
PANELA_EMAIL_REPORT_TO=
PANELA_ALLOWED_EMAIL_RECIPIENTS=

# Optional constrained Responses proposal. Both are required; no default model.
OPENAI_API_KEY=
OPENAI_MODEL=

# This increment has outbound adapters only. Slack/Resend/Gmail inbound, live
# camera ingestion, scheduled reminders and authenticated operators are pending.
